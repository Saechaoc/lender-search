# Local Postgres connection string (docker compose provisions app_user — NOBYPASSRLS NOSUPERUSER).
# Used by the runtime app (lib/db/client.ts) and pen tests so FORCE RLS is meaningful;
# superusers bypass RLS silently and would make pen tests vacuous.
DATABASE_URL=postgresql://app_user:app_user_password@localhost:5432/lender_search_dev

# Migration-only connection (postgres superuser; owns the tables). Required because only
# the owner can ALTER TABLE FORCE ROW LEVEL SECURITY (Plan 01-05) and CREATE TABLE / POLICY.
# drizzle-kit (generate, migrate) reads this from drizzle.config.ts; falls back to
# DATABASE_URL if unset (covers CI envs that only have the privileged connection).
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/lender_search_dev

# Pen-test JWT signing secret (HS256 fixture; min 16 chars)
RLS_TEST_JWT_SECRET=local-dev-fixture-secret-change-me

# Phase 1: optional. Phase 6 wires the real Supabase project and tightens to required.
# SUPABASE_SERVICE_ROLE_KEY=
