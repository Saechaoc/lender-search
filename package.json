{
  "name": "lender-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:rls": "vitest run --config vitest.config.ts",
    "test:rls:watch": "vitest --config vitest.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-core": "0.13.11",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@types/node": "20.19.4",
    "@types/pg": "8.15.5",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "10.2.1",
    "jose": "6.2.3",
    "pg": "8.20.0",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.46.0",
    "vitest": "4.1.5"
  }
}
